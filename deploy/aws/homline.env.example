# ============================================================
# HOMLine DIGI Seva — Production Environment File Template
# ============================================================
# Copy this to /etc/homline/homline.env on the EC2 instance.
# Never commit the real .env file to version control.
#
# Secure the file after creating it:
#   sudo chmod 600 /etc/homline/homline.env
#   sudo chown root:root /etc/homline/homline.env
# ============================================================

# --- Django core ---
DEBUG=False

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=<replace-with-a-long-random-secret-key>

# Comma-separated list of accepted hostnames (no spaces)
ALLOWED_HOSTS=homline.in,www.homline.in,13.60.186.138

# Must include the https:// scheme and exact domain
CSRF_TRUSTED_ORIGINS=https://homline.in,https://www.homline.in

# --- PostgreSQL (AWS RDS) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# The sslmode=require is strongly recommended for RDS
DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>?sslmode=require

# --- Cloudflare R2 (private document storage) ---
# Required in production — the app refuses to start without these
R2_BUCKET_NAME=<your-private-bucket-name>
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<bucket-scoped-key-id>
R2_SECRET_ACCESS_KEY=<bucket-scoped-key-secret>

# --- Optional ---
# LOG_LEVEL=INFO
# MEDIA_ROOT=/home/ubuntu/homline-django-webapp/media
